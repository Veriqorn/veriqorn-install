# New installations may start with latest. The update agent replaces it with a
# pinned stable release tag only after it has pulled and validated both images.
PLATFORM_VERSION=latest
PLATFORM_UPDATE_AGENT_TOKEN=replace-with-a-long-random-secret

JWT_SECRET=change-me-to-a-long-random-string
# Required only for the first empty database. Use a unique password; no default
# application accounts are created by the platform.
BACKEND_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=test_ops
POSTGRES_HOST_PORT=5432
VERIQORN_POSTGRES_VOLUME=veriqorn-postgres-data

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# Backend uses this least-privilege account rather than the MinIO root account.
MINIO_SERVICE_ACCESS_KEY=veriqorn-app
MINIO_SERVICE_SECRET_KEY=change-me-to-a-unique-minio-service-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
VERIQORN_MINIO_VOLUME=veriqorn-minio-data

FRONTEND_PORT=3000
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KB_URL=http://localhost:5174
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Production TLS: set a public DNS name and run `docker compose --profile tls up -d`.
# Caddy obtains and renews the certificate automatically. Set the three URLs to HTTPS.
# VERIQORN_PUBLIC_HOST=veriqorn.example.com
# FRONTEND_URL=https://veriqorn.example.com
# CORS_ORIGINS=https://veriqorn.example.com
# NEXT_PUBLIC_API_URL=https://veriqorn.example.com
# BACKEND_SECURE_COOKIES=true
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated allowlist for LLM and evidence-connector destinations.
# Only these hosts may receive outbound requests from the backend. Add internal
# DNS names explicitly; wildcard subdomains such as *.example.com are supported.
OUTBOUND_ALLOWED_HOSTS=api.openai.com

# Optional: restrict filesystem-backed imports and repository indexing further.
# ALLURE_IMPORT_ROOT=backend/uploads
# LOCAL_REPOSITORY_ROOTS=backend/src,frontend/src,packages/contracts/src,kb-site/src,test

# Optional
# FRONTEND_IMAGE=ghcr.io/veriqorn/veriqorn-frontend
# BACKEND_IMAGE=ghcr.io/veriqorn/veriqorn-backend
# AI_ANALYSIS_LICENSE_PUBLIC_KEY=
# PLATFORM_UPDATE_AGENT_URL=http://update-agent:8787
# UPDATE_RELEASES_URL=https://raw.githubusercontent.com/veriqorn/veriqorn-install/master/releases/latest.json
# UPDATE_COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v2.4.3
# UPDATE_COSIGN_IDENTITY=https://github.com/veriqorn/veriqorn-platform/.github/workflows/publish-platform-images.yml@refs/tags/v*
# VERIQORN_UPDATE_AGENT_VOLUME=veriqorn-update-agent-state
