# New installations may start with latest. The update agent replaces it with a
# pinned stable release tag only after it has pulled and validated both images.
PLATFORM_VERSION=latest
PLATFORM_UPDATE_AGENT_TOKEN=replace-with-a-long-random-secret

JWT_SECRET=change-me-to-a-long-random-string

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=test_ops
POSTGRES_HOST_PORT=5432
VERIQORN_POSTGRES_VOLUME=veriqorn-postgres-data

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
VERIQORN_MINIO_VOLUME=veriqorn-minio-data

FRONTEND_PORT=3000
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KB_URL=http://localhost:5174
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional
# FRONTEND_IMAGE=ghcr.io/veriqorn/veriqorn-frontend
# BACKEND_IMAGE=ghcr.io/veriqorn/veriqorn-backend
# AI_ANALYSIS_LICENSE_PUBLIC_KEY=
# PLATFORM_UPDATE_AGENT_URL=http://update-agent:8787
# UPDATE_RELEASES_URL=https://api.github.com/repos/veriqorn/veriqorn-platform/releases/latest
# VERIQORN_UPDATE_AGENT_VOLUME=veriqorn-update-agent-state
