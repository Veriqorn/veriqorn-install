# Copy this file to .env.enterprise. Do not commit the real file or the
# license itself. Docker Compose reads the path and mounts that file read-only
# into the Enterprise backend.
# Use full immutable image references. v0.2.7 will be published as one common
# Community/Enterprise release train. Keep these repositories separate from
# the pinned values: the updater needs them to resolve the next signed tag.
ENTERPRISE_BACKEND_IMAGE_REPOSITORY=ghcr.io/veriqorn/veriqorn-enterprise-backend
ENTERPRISE_FRONTEND_IMAGE_REPOSITORY=ghcr.io/veriqorn/veriqorn-enterprise-frontend
ENTERPRISE_BACKEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-backend@sha256:a4302257162414bfeeab013fc4176b55bcd37825255d17683b54a78da9b353d8
ENTERPRISE_FRONTEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-frontend@sha256:6fd695dece2acb0cd612724ea34ea5372c956c19665b13a9b9a32c099313a943
PLATFORM_VERSION=v0.2.7
VERIQORN_LICENSE_FILE=./licenses/veriqorn-license.json
# The Enterprise image already contains Veriqorn's production public
# verification key. Do not add the issuer private key here.
# Secret used only to encrypt the persistent installation-private key. Generate
# one once with `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` and retain
# it in the deployment secret store for the lifetime of this installation.
VERIQORN_INSTALLATION_KEY_ENCRYPTION_KEY=
