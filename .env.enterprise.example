# Copy this file to .env.enterprise. Do not commit the real file or the
# license itself. Docker Compose reads the path and mounts that file read-only
# into the Enterprise backend.
ENTERPRISE_VERSION=latest
ENTERPRISE_BACKEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-backend
ENTERPRISE_FRONTEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-frontend
VERIQORN_LICENSE_FILE=./licenses/veriqorn-license.json
