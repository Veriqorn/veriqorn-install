# Copy this file to .env.enterprise. Do not commit the real file or the
# license itself. Docker Compose reads the path and mounts that file read-only
# into the Enterprise backend.
# Use full immutable image references. v0.1.0 is tested with Community Core v0.2.6.
ENTERPRISE_BACKEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-backend@sha256:479f2e264feea87a179c90e25fc7442a7f0b12118266f2440451dca16f0eca8c
ENTERPRISE_FRONTEND_IMAGE=ghcr.io/veriqorn/veriqorn-enterprise-frontend@sha256:9fb7fa02ec97db2eaceba3716addc918bedcbd8381950f5e92e891f2d9d2d7f2
VERIQORN_LICENSE_FILE=./licenses/veriqorn-license.json
# The Enterprise image already contains Veriqorn's production public
# verification key. Do not add the issuer private key here.
# Secret used only to encrypt the persistent installation-private key. Generate
# one once with `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` and retain
# it in the deployment secret store for the lifetime of this installation.
VERIQORN_INSTALLATION_KEY_ENCRYPTION_KEY=
